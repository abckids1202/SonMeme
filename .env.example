APP_NAME=Sonify
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

FRONTEND_ORIGINS=http://localhost:5173

MODEL_DEVICE=auto
MODEL_RUNTIME=pytorch

DETECTOR_MODEL_PATH=../models/pytorch/face_detector.pt
LANDMARK_MODEL_PATH=../models/pytorch/landmark_model.pt
GENERATOR_MODEL_PATH=../models/pytorch/identity_generator.pt

ONNX_DETECTOR_PATH=../models/onnx/face_detector.onnx
ONNX_LANDMARK_PATH=../models/onnx/landmark_model.onnx
ONNX_GENERATOR_PATH=../models/onnx/identity_generator.onnx

TEMP_DIRECTORY=./runtime/temp
TEMP_TTL_MINUTES=30

MAX_UPLOAD_MB=15
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
PREVIEW_MAX_SIDE=1280

DETECTION_CONFIDENCE_THRESHOLD=0.45
DETECTION_NMS_THRESHOLD=0.40
MAX_FACES_PER_IMAGE=20

ENABLE_NEURAL_SWAP=false
ENABLE_DEBUG_OUTPUTS=true
PUBLIC_DEPLOYMENT=false
